# Server
PORT=3000
NODE_ENV=development
DEMO_MODE=true

# Database (SQLite for local/hackathon, or PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=access-hackathon-super-secret-key-32chars
JWT_EXPIRES_IN=7d

# GTFS Static (Generic URL)
GTFS_FEED_URL=
GTFS_AUTH_HEADER=
GTFS_ENABLED=false
GTFS_DOWNLOAD_DIR=./data/gtfs

# GTFS Realtime
GTFS_RT_VEHICLE_POSITIONS_URL=
GTFS_RT_TRIP_UPDATES_URL=
GTFS_RT_SERVICE_ALERTS_URL=
GTFS_RT_AUTH_HEADER=
GTFS_RT_ENABLED=false
GTFS_RT_POLL_INTERVAL_SECONDS=60

# Odisha Transport / CRUT Mo Bus (Credential Gated)
CRUT_API_URL=
CRUT_API_KEY=
OSRTC_API_URL=
ODISHA_PROVIDER_ENABLED=false

# OpenStreetMap / Overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_DIR=./data/osm_cache
OSM_CACHE_TTL_HOURS=24
OSM_ENABLED=true

# Safety Session Timing (minutes)
SAFETY_FIRST_ESCALATION_MINUTES=5
SAFETY_SECOND_ESCALATION_MINUTES=15
SAFETY_HEARTBEAT_INTERVAL_MINUTES=10
SAFETY_SESSION_EXPIRY_HOURS=4

# Notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ENABLED=false
SENDGRID_API_KEY=
EMAIL_ENABLED=false

# Data Freshness Thresholds (seconds)
FRESHNESS_VEHICLE_FRESH_SEC=120
FRESHNESS_VEHICLE_STALE_SEC=600
FRESHNESS_CROWDING_FRESH_SEC=300
FRESHNESS_CROWDING_STALE_SEC=1800

# ML / Predictions
ML_CROWDING_MIN_SAMPLES=5
ML_TRAINING_INTERVAL_HOURS=24

# Data Retention (days/hours)
RETENTION_LOCATION_SIGNALS_DAYS=7
RETENTION_REPORT_EXPIRE_HOURS=48
RETENTION_INGESTION_RUNS_DAYS=30
